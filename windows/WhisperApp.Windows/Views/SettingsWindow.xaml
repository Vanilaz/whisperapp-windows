<Window x:Class="WhisperApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhisperApp.Views"
        Title="Whisper Settings" Width="460" Height="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" >
            <TextBlock Text="Whisper Settings" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

            <!-- Hotkey -->
            <TextBlock Text="Global Hotkey" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Shortcut:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <local:HotkeyRecorderControl x:Name="HotkeyRecorder" Margin="0,0,12,0"/>
                <Button x:Name="ChangeButton" Content="Change" Width="80" Margin="0,0,8,0"
                        Click="OnChangeHotkeyClick"/>
                <Button x:Name="ResetButton" Content="Reset" Width="70" Click="OnResetHotkeyClick"/>
            </StackPanel>
            <CheckBox x:Name="HoldModeCheckBox" Content="Hold to talk (press &amp; hold to record, release to stop)"
                      Margin="0,4,0,4" Checked="OnHoldModeChanged" Unchecked="OnHoldModeChanged"/>
            <TextBlock Text="Toggle mode: double-tap to start, single tap to stop · Hold mode: press and hold to record"
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <Separator Margin="0,0,0,16"/>

            <!-- Groq key (STT + AI correction) -->
            <TextBlock Text="Groq API Key" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="GroqDescription" FontSize="11" Foreground="Gray"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <PasswordBox x:Name="GroqKeyBox" Margin="0,0,0,8" Padding="6,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="SaveButton" Content="Save" Width="80" Margin="0,0,8,0" Click="OnSaveClick"/>
                <Button x:Name="TestButton" Content="Test" Width="80" Margin="0,0,12,0" Click="OnTestClick"/>
                <TextBlock x:Name="GroqMessage" Text="" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <TextBlock Text="Get a free key at console.groq.com — or set the GROQ_API_KEY environment variable to skip entering a key"
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>
