<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Whisper</AssemblyName>
    <RootNamespace>WhisperApp</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.2.0</Version>
    <Product>Whisper</Product>
    <Company>Gamezxz</Company>
    <Copyright>© 2026 Gamezxz</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Menu-bar-only app: no console window -->
    <StartupObject>WhisperApp.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- UseWPF + UseWindowsForms together make the SDK implicitly global-using both
       System.Windows.*/System.Drawing and System.Windows.Forms project-wide, which collide
       on Application/UserControl/KeyEventArgs/Brushes/Color/etc. Only TrayIconManager.cs
       needs the WinForms/Drawing types (NotifyIcon, Icon), and it already has its own
       explicit `using System.Windows.Forms;` + `using System.Drawing;`, so drop both
       implicit globals to resolve the ambiguity everywhere else. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

</Project>
